---
import { Download, X } from "lucide-astro";
import { personal } from "../../data/details";

const src = personal.resume;
---

<dialog
  id="resume-dialog"
  aria-label="Resume preview"
  class="m-auto h-[92vh] w-[94vw] max-w-[1000px] overflow-hidden rounded-[20px] border border-[#232323] bg-[#0e0e0e] p-0 text-[#f5f5f5] shadow-[0_40px_120px_-20px_rgba(0,0,0,0.9)] backdrop:bg-black/75 backdrop:backdrop-blur-md"
>
  <div class="flex h-full flex-col">

    <!-- Toolbar -->
    <div
      class="flex shrink-0 items-center justify-between gap-3 border-b border-[#232323] bg-[#0e0e0e] px-5 py-3"
    >
      <!-- Title -->
      <div class="flex items-center gap-2.5">
        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>

        <p class="m-0 text-sm font-medium tracking-[-0.01em]">
          Resume
        </p>
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-2">

        <!-- Download -->
        <a
          href={src}
          download="Sakthivel-Resume.pdf"
          class="inline-flex items-center gap-2 rounded-full bg-[#f5f5f5] px-4 py-2 text-sm font-medium text-[#0a0a0a] no-underline transition-transform duration-200 hover:-translate-y-0.5"
        >
          <Download class="h-4 w-4" />
          Download
        </a>

        <!-- Close -->
        <button
          type="button"
          data-resume-close
          aria-label="Close resume"
          class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-[#2a2a2a] bg-transparent text-[#aaa] transition-colors duration-200 hover:border-[#666] hover:text-[#f5f5f5]"
        >
          <X class="h-4 w-4" />
        </button>

      </div>
    </div>

    <!-- PDF viewer -->
    <div
      class="relative min-h-0 flex-1 overflow-y-auto bg-[#202020] p-4 sm:p-6"
    >

      <!-- Loading -->
      <div
        id="resume-loading"
        class="absolute inset-0 z-10 flex items-center justify-center bg-[#111]"
      >
        <div class="flex items-center gap-3 text-sm text-[#777]">
          <span
            class="h-4 w-4 animate-spin rounded-full border-2 border-[#444] border-t-[#f5f5f5]"
          ></span>

          Loading resume...
        </div>
      </div>

      <!-- Error -->
      <div
        id="resume-error"
        class="absolute inset-0 z-10 hidden items-center justify-center bg-[#111] px-6 text-center"
      >
        <div>
          <p class="text-sm text-[#777]">
            Couldn't display the resume.
          </p>

          <a
            href={src}
            download="Sakthivel-Resume.pdf"
            class="mt-4 inline-flex rounded-full bg-[#f5f5f5] px-4 py-2 text-sm font-medium text-[#0a0a0a] no-underline"
          >
            Download Resume
          </a>
        </div>
      </div>

      <!-- PDF pages -->
      <div
        id="resume-pages"
        class="mx-auto flex max-w-[900px] flex-col items-center gap-5"
      ></div>

    </div>
  </div>
</dialog>

<script>
  import * as pdfjsLib from "pdfjs-dist/legacy/build/pdf.mjs";
  import workerSrc from "pdfjs-dist/legacy/build/pdf.worker.mjs?url";

  /*
   * Tell PDF.js where its worker is.
   *
   * Vite turns ?url into the final production
   * URL of the bundled worker file.
   */
  pdfjsLib.GlobalWorkerOptions.workerSrc =
    workerSrc;

  const dialog =
    document.querySelector<HTMLDialogElement>(
      "#resume-dialog"
    );

  const pages =
    document.querySelector<HTMLElement>(
      "#resume-pages"
    );

  const loading =
    document.querySelector<HTMLElement>(
      "#resume-loading"
    );

  const error =
    document.querySelector<HTMLElement>(
      "#resume-error"
    );

  if (
    dialog &&
    pages &&
    loading &&
    error
  ) {
    const src =
      dialog.dataset.src ??
      "/resume.pdf";

    let loaded = false;

    const showLoading = () => {
      loading.classList.remove("hidden");
      loading.classList.add("flex");

      error.classList.add("hidden");
      error.classList.remove("flex");
    };

    const showError = () => {
      loading.classList.add("hidden");
      loading.classList.remove("flex");

      error.classList.remove("hidden");
      error.classList.add("flex");
    };

    const renderResume = async () => {
      if (loaded) {
        return;
      }

      try {
        showLoading();

        /*
         * Fetch PDF
         */
        const response =
          await fetch(src);

        if (!response.ok) {
          throw new Error(
            `PDF request failed: ${response.status}`
          );
        }

        const data =
          new Uint8Array(
            await response.arrayBuffer()
          );

        /*
         * Load PDF
         */
        const pdf =
          await pdfjsLib
            .getDocument({
              data,
            })
            .promise;

        /*
         * Calculate display size
         */
        const dpr =
          Math.min(
            window.devicePixelRatio || 1,
            2
          );

        const availableWidth =
          Math.min(
            pages.clientWidth,
            900
          );

        /*
         * Render each page
         */
        for (
          let pageNumber = 1;
          pageNumber <= pdf.numPages;
          pageNumber++
        ) {
          const page =
            await pdf.getPage(
              pageNumber
            );

          const baseViewport =
            page.getViewport({
              scale: 1,
            });

          const scale =
            availableWidth /
            baseViewport.width;

          const viewport =
            page.getViewport({
              scale:
                scale * dpr,
            });

          const canvas =
            document.createElement(
              "canvas"
            );

          const context =
            canvas.getContext(
              "2d"
            );

          if (!context) {
            continue;
          }

          /*
           * High resolution canvas
           */
          canvas.width =
            Math.floor(
              viewport.width
            );

          canvas.height =
            Math.floor(
              viewport.height
            );

          /*
           * Display size
           */
          canvas.style.width =
            `${viewport.width / dpr}px`;

          canvas.style.height =
            `${viewport.height / dpr}px`;

          canvas.className =
            "block max-w-full rounded-sm bg-white shadow-[0_10px_40px_rgba(0,0,0,0.4)]";

          pages.appendChild(
            canvas
          );

          await page.render({
            canvasContext: context,
            viewport,
          }).promise;
        }

        loaded = true;

        loading.classList.add(
          "hidden"
        );

        loading.classList.remove(
          "flex"
        );

      } catch (err) {
        console.error(
          "Resume preview error:",
          err
        );

        pages.replaceChildren();

        showError();
      }
    };

    /*
     * Open resume
     */
    document
      .querySelectorAll<HTMLElement>(
        "[data-resume-open]"
      )
      .forEach((button) => {

        button.addEventListener(
          "click",
          (event) => {
            event.preventDefault();

            dialog.showModal();

            document.documentElement.style.overflow =
              "hidden";

            renderResume();
          }
        );

      });

    /*
     * Close button
     */
    dialog
      .querySelector(
        "[data-resume-close]"
      )
      ?.addEventListener(
        "click",
        () => {
          dialog.close();
        }
      );

    /*
     * Close by clicking backdrop
     */
    dialog.addEventListener(
      "click",
      (event) => {

        if (
          event.target === dialog
        ) {
          dialog.close();
        }

      }
    );

    /*
     * Restore scrolling
     */
    dialog.addEventListener(
      "close",
      () => {
        document.documentElement.style.overflow =
          "";
      }
    );
  }
</script>