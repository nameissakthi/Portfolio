---
import { ArrowUpRight, Download, Github, Play } from "lucide-astro";
import SectionHeader from "./SectionHeader.astro";
import ProjectMedia from "./ProjectMedia.astro";
import { projects } from "../../data/projects";
import type { Project } from "../../data/projects";

/*
  Buttons depend on the project type, and any link that is missing is hidden:
    web     -> Live project, Source
    mobile  -> Demo, Download, Source
    desktop -> Demo, Download, Source
*/
const buttonsFor = (project: Project) => {
  const type = project.type ?? "web";

  const list =
    type === "web"
      ? [{ label: "Live project", href: project.liveUrl, Icon: ArrowUpRight, arrow: true }]
      : [
          { label: "Demo", href: project.demoUrl, Icon: Play, arrow: false },
          { label: "Download", href: project.downloadUrl, Icon: Download, arrow: false },
        ];

  list.push({ label: "Source", href: project.githubUrl, Icon: Github, arrow: false });

  return list.filter((button) => Boolean(button.href));
};
---

<section id="projects" class="bg-[#0a0a0a] px-6 py-24 text-[#f5f5f5]">
  <div class="mx-auto w-full max-w-[1200px]">
    <SectionHeader>
      Things I've<br />built.
    </SectionHeader>

    <!-- On large screens each card sticks and the next one slides over it -->
    <div class="flex flex-col gap-6 lg:gap-8">
      {
        projects.map((project, index) => {
          const buttons = buttonsFor(project);

          return (
            <article
              data-stack-card
              class="group rounded-3xl border border-[#1f1f1f] bg-[#0e0e0e] p-5 shadow-[0_-30px_60px_-20px_rgba(0,0,0,0.9)] md:p-8 lg:sticky"
              style={`top:${96 + index * 20}px`}
            >
              <div class="grid items-center gap-8 lg:grid-cols-[1.2fr_1fr] lg:gap-14">
                <!-- Media (browser, phone or desktop window) -->
                <div class={index % 2 !== 0 ? "lg:order-2" : ""}>
                  <ProjectMedia project={project} />
                </div>

                <!-- Content -->
                <div class={index % 2 !== 0 ? "lg:order-1" : ""}>
                  <span class="inline-block rounded-full border border-[#2a2a2a] px-3 py-1 text-xs text-[#888]">
                    {project.category}
                  </span>

                  <h3
                    class="m-0 mt-6 text-[clamp(2.2rem,4.2vw,3.6rem)] font-medium leading-[0.95] tracking-[-0.055em]"
                  >
                    {project.title}
                  </h3>

                  <p class="m-0 mt-5 max-w-[480px] text-[15px] leading-7 text-[#777]">
                    {project.description}
                  </p>

                  <ul class="m-0 mt-6 flex list-none flex-wrap gap-2 p-0">
                    {project.technologies.map((technology) => (
                      <li class="rounded-full bg-white/[0.05] px-3 py-1.5 text-xs text-[#a5a5a5]">
                        {technology}
                      </li>
                    ))}
                  </ul>

                  {buttons.length > 0 && (
                    <div class="mt-8 flex flex-wrap items-center gap-3">
                      {buttons.map((button, i) => {
                        const Icon = button.Icon;

                        return (
                          <a
                            href={button.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class:list={[
                              "group/link inline-flex items-center gap-2 rounded-full px-5 py-3 text-sm font-medium no-underline transition duration-200",
                              i === 0
                                ? "bg-[#f5f5f5] text-[#0a0a0a] hover:-translate-y-0.5"
                                : "border border-[#303030] text-[#c4c4c4] hover:border-[#666] hover:text-[#f5f5f5]",
                            ]}
                          >
                            {!button.arrow && <Icon class="h-4 w-4" />}
                            {button.label}
                            {button.arrow && (
                              <Icon class="h-4 w-4 transition-transform duration-200 group-hover/link:-translate-y-0.5 group-hover/link:translate-x-0.5" />
                            )}
                          </a>
                        );
                      })}
                    </div>
                  )}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  /*
    Each card sticks near the top while the next one slides over it.
    If a card is taller than the screen, its sticky offset becomes negative so the
    bottom of the card (the buttons) is always reachable instead of being cut off.
  */
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-stack-card]"));

  const place = () => {
    const vh = window.innerHeight;

    cards.forEach((card, i) => {
      const wanted = 96 + i * 20;
      const fits = vh - card.offsetHeight - 24;
      card.style.top = `${Math.min(wanted, fits)}px`;
    });
  };

  place();
  window.addEventListener("resize", place);
  window.addEventListener("load", place);

  if ("ResizeObserver" in window) {
    const observer = new ResizeObserver(place);
    cards.forEach((card) => observer.observe(card));
  }
</script>