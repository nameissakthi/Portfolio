---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ArrowUpRight, Github } from "lucide-astro";
import SectionHeader from "./SectionHeader.astro";
import { projects } from "../../data/projects";

/*
  Optimised images: keep the screenshots in src/assets/projects/ with the same
  file names used in projects.js (project1.png, project2.png, ...).
  If a file isn't found there, it falls back to the path in /public.
*/
const localImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projects/*.{png,jpg,jpeg,webp,avif}",
  { eager: true }
);

const resolveImage = (path: string) => {
  const file = path.split("/").pop() ?? "";
  return localImages[`/src/assets/projects/${file}`]?.default;
};

const host = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return url;
  }
};
---

<section id="projects" class="bg-[#0a0a0a] px-6 py-24 text-[#f5f5f5]">
  <div class="mx-auto w-full max-w-[1200px]">
    <SectionHeader>
      Things I've<br />built.
    </SectionHeader>

    <!-- On large screens each card sticks and the next one slides over it -->
    <div class="flex flex-col gap-6 lg:gap-8">
      {
        projects.map((project, index) => {
          const local = resolveImage(project.image);
          const alt = `${project.title} project screenshot`;
          const imgClass =
            "h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.04]";

          return (
            <article
              class="group rounded-3xl border border-[#1f1f1f] bg-[#0e0e0e] p-5 shadow-[0_-30px_60px_-20px_rgba(0,0,0,0.9)] md:p-8 lg:sticky"
              style={`top:${96 + index * 20}px`}
            >
              <div class="grid items-center gap-8 lg:grid-cols-[1.2fr_1fr] lg:gap-14">
                <!-- Browser frame -->
                <div
                  class={`overflow-hidden rounded-xl border border-[#252525] bg-[#111] ${
                    index % 2 !== 0 ? "lg:order-2" : ""
                  }`}
                >
                  <div class="flex h-10 items-center gap-2 border-b border-[#222] bg-[#151515] px-4">
                    <span class="h-3 w-3 rounded-full bg-[#ff5f57]" />
                    <span class="h-3 w-3 rounded-full bg-[#febc2e]" />
                    <span class="h-3 w-3 rounded-full bg-[#28c840]" />
                    <span class="ml-3 truncate rounded-md bg-[#0e0e0e] px-3 py-1 text-[11px] text-[#666]">
                      {host(project.liveUrl)}
                    </span>
                  </div>

                  <div class="aspect-[16/10] overflow-hidden">
                    {local ? (
                      <Image
                        src={local}
                        alt={alt}
                        widths={[640, 960, 1280]}
                        sizes="(min-width: 1024px) 640px, 100vw"
                        loading="lazy"
                        class={imgClass}
                      />
                    ) : (
                      <Image
                        src={project.image}
                        alt={alt}
                        width={1600}
                        height={1000}
                        loading="lazy"
                        class={imgClass}
                      />
                    )}
                  </div>
                </div>

                <!-- Content -->
                <div class={index % 2 !== 0 ? "lg:order-1" : ""}>
                  <span class="inline-block rounded-full border border-[#2a2a2a] px-3 py-1 text-xs text-[#888]">
                    {project.category}
                  </span>

                  <h3
                    class="m-0 mt-6 text-[clamp(2.2rem,4.2vw,3.6rem)] font-medium leading-[0.95] tracking-[-0.055em]"
                  >
                    {project.title}
                  </h3>

                  <p class="m-0 mt-5 max-w-[480px] text-[15px] leading-7 text-[#777]">
                    {project.description}
                  </p>

                  <ul class="m-0 mt-6 flex list-none flex-wrap gap-2 p-0">
                    {project.technologies.map((technology: string) => (
                      <li class="rounded-full bg-white/[0.05] px-3 py-1.5 text-xs text-[#a5a5a5]">
                        {technology}
                      </li>
                    ))}
                  </ul>

                  <div class="mt-8 flex flex-wrap items-center gap-3">
                    <a
                      href={project.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group/link inline-flex items-center gap-2 rounded-full bg-[#f5f5f5] px-5 py-3 text-sm font-medium text-[#0a0a0a] no-underline transition-transform duration-200 hover:-translate-y-0.5"
                    >
                      Live project
                      <ArrowUpRight
                        class="h-4 w-4 transition-transform duration-200 group-hover/link:-translate-y-0.5 group-hover/link:translate-x-0.5"
                      />
                    </a>

                    <a
                      href={project.githubUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 rounded-full border border-[#303030] px-5 py-3 text-sm font-medium text-[#c4c4c4] no-underline transition-colors duration-200 hover:border-[#666] hover:text-[#f5f5f5]"
                    >
                      <Github class="h-4 w-4" />
                      Source
                    </a>
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>