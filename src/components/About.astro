---
import SectionHeader from "./SectionHeader.astro";
import { personal, education } from "../../data/details";

/* Put your photo at public/about.jpg (portrait works best, around 4:5). */
const photo = "/about.jpg";

/* Placeholders: replace these with your real interests. */
const interests = ["Cricket", "Music", "Reading", "Gaming"];

const statement = `I'm a full-stack developer from ${personal.location}. I build web applications and the backend systems behind them, from internship projects to enterprise microservices, and I'm looking for my next full-stack role.`;
const words = statement.split(" ");
---

<section id="about" class="bg-[#0a0a0a] px-6 py-24 text-[#f5f5f5]">
  <div class="mx-auto w-full max-w-[1200px]">
    <SectionHeader>
      A bit<br />about me.
    </SectionHeader>

    <div data-spot-grid class="grid gap-10 lg:grid-cols-[1.3fr_0.7fr] lg:items-start lg:gap-14">
      <!-- Left: statement + two cards -->
      <div class="flex flex-col gap-12">
        <p
          data-statement
          class="m-0 text-[clamp(1.6rem,3vw,2.6rem)] font-medium leading-[1.18] tracking-[-0.04em]"
        >
          {words.map((word) => <span class="word">{word} </span>)}
        </p>

        <div class="grid gap-3 sm:grid-cols-2">
          <!-- Education -->
          <div
            data-spot-card
            class="spot-card relative flex flex-col justify-between gap-8 rounded-2xl border border-[#1c1c1c] bg-[#0e0e0e] p-7"
          >
            <h3 class="relative z-10 m-0 text-lg font-medium leading-[1.2] tracking-[-0.02em]">
              Education
            </h3>

            <div class="relative z-10">
              <p class="m-0 text-xl font-medium leading-[1.2] tracking-[-0.03em]">
                {education.institution}
              </p>
              <p class="m-0 mt-2 text-[15px] text-[#888]">{education.degree}</p>
              <p class="m-0 mt-1 text-sm text-[#666]">{education.period}</p>

              <span
                class="mt-5 inline-block rounded-full border border-[#242424] bg-[#131313] px-3 py-1.5 text-xs text-[#aaa]"
              >
                {education.result}
              </span>
            </div>
          </div>

          <!-- Interests -->
          <div
            data-spot-card
            class="spot-card relative flex flex-col justify-between gap-8 rounded-2xl border border-[#1c1c1c] bg-[#0e0e0e] p-7"
          >
            <h3 class="relative z-10 m-0 text-lg font-medium leading-[1.2] tracking-[-0.02em]">
              Interests
            </h3>

            <ul class="relative z-10 m-0 flex list-none flex-wrap gap-2 p-0">
              {
                interests.map((item) => (
                  <li class="interest rounded-full border border-[#242424] bg-[#131313] px-4 py-2 text-sm text-[#bdbdbd] transition-colors duration-200 hover:border-[#555] hover:text-[#f5f5f5]">
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      <!-- Right: photo -->
      <div
        data-spot-card
        class="spot-card group relative mx-auto aspect-[4/5] w-full max-w-[420px] overflow-hidden rounded-2xl border border-[#1c1c1c] bg-[#0e0e0e] lg:sticky lg:top-28 lg:max-w-none"
      >
        <!-- Fallback initial, visible only if the photo is missing -->
        <span
          aria-hidden="true"
          class="absolute inset-0 flex items-center justify-center text-[10rem] font-medium tracking-[-0.06em] text-[#1a1a1a]"
        >
          {personal.name.charAt(0)}
        </span>

        <img
          src={photo}
          alt={`Portrait of ${personal.name}`}
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover grayscale transition duration-500 group-hover:scale-[1.03] group-hover:grayscale-0"
          onerror="this.style.display='none'"
        />

        <div
          aria-hidden="true"
          class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/70 to-transparent"
        >
        </div>

        <span
          class="absolute bottom-4 left-4 z-30 rounded-full border border-white/10 bg-black/50 px-3 py-1.5 text-xs text-[#ddd] backdrop-blur-md"
        >
          Based in {personal.location}
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  /* Scroll-lit statement */
  .word {
    color: #333;
    transition: color 350ms ease;
  }

  .word.is-on {
    color: #f5f5f5;
  }

  /* Cursor spotlight, same treatment as the skills grid */
  .spot-card::before,
  .spot-card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 20;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .spot-card::before {
    padding: 1px;
    background: radial-gradient(
      340px circle at var(--mx, 50%) var(--my, 50%),
      rgba(255, 255, 255, 0.65),
      transparent 65%
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
  }

  .spot-card::after {
    background: radial-gradient(
      420px circle at var(--mx, 50%) var(--my, 50%),
      rgba(255, 255, 255, 0.05),
      transparent 70%
    );
  }

  @media (hover: hover) {
    [data-spot-grid]:hover .spot-card::before,
    [data-spot-grid]:hover .spot-card::after {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .word,
    .spot-card::before,
    .spot-card::after {
      transition: none;
    }
  }
</style>

<script>
  // Scroll-lit statement
  const statement = document.querySelector<HTMLElement>("[data-statement]");

  if (statement) {
    const words = Array.from(statement.querySelectorAll<HTMLElement>(".word"));

    const update = () => {
      const rect = statement.getBoundingClientRect();
      const start = window.innerHeight * 0.85;
      const end = window.innerHeight * 0.4;
      const progress = Math.min(Math.max((start - rect.top) / (start - end + rect.height), 0), 1);
      const lit = Math.round(progress * words.length);

      words.forEach((word, i) => word.classList.toggle("is-on", i < lit));
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }

  // Cursor spotlight
  document.querySelectorAll<HTMLElement>("[data-spot-grid]").forEach((grid) => {
    const cards = grid.querySelectorAll<HTMLElement>("[data-spot-card]");

    grid.addEventListener("pointermove", (e) => {
      cards.forEach((card) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty("--mx", `${e.clientX - r.left}px`);
        card.style.setProperty("--my", `${e.clientY - r.top}px`);
      });
    });
  });
</script>