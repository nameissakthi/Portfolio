---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Sakthivel",
  description =
    "Portfolio of Sakthivel, a Full-Stack Developer focused on building modern web applications and backend systems.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content={description}
    />

    <meta
      name="theme-color"
      content="#0a0a0a"
    />

    <!-- Favicon -->
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg?v=4"
    />

    <link
      rel="shortcut icon"
      href="/favicon.svg?v=4"
    />

    <title>{title}</title>

    <!-- Vercel -->
    <Analytics />
    <SpeedInsights />
  </head>

  <body>
    <slot />

    <script>
      const originalTitle = "Sakthivel";

      const glitchFrames = [
        "Sakthive_",
        "Sakthiv3l",
        "Sakth!vel",
        "Sakth1vel",
        "Sakthivel",
      ];

      let isGlitching = false;
      let glitchTimer: number | undefined;
      let intervalTimer: number | undefined;

      const glitchTitle = () => {
        if (document.hidden || isGlitching) {
          return;
        }

        isGlitching = true;

        let frame = 0;

        glitchTimer = window.setInterval(() => {
          if (document.hidden) {
            if (glitchTimer) {
              clearInterval(glitchTimer);
            }

            document.title = originalTitle;
            isGlitching = false;

            return;
          }

          document.title =
            glitchFrames[frame];

          frame++;

          if (
            frame >=
            glitchFrames.length
          ) {
            if (glitchTimer) {
              clearInterval(
                glitchTimer
              );
            }

            document.title =
              originalTitle;

            isGlitching = false;
          }
        }, 90);
      };

      const startGlitchTimer = () => {
        if (intervalTimer) {
          clearInterval(
            intervalTimer
          );
        }

        if (!document.hidden) {
          intervalTimer =
            window.setInterval(() => {
              if (
                !document.hidden
              ) {
                glitchTitle();
              }
            }, 7000);
        }
      };

      window.setTimeout(() => {
        if (!document.hidden) {
          glitchTitle();
        }
      }, 1500);

      document.addEventListener(
        "visibilitychange",
        () => {
          if (document.hidden) {
            if (glitchTimer) {
              clearInterval(
                glitchTimer
              );
            }

            document.title =
              originalTitle;

            isGlitching = false;

            if (intervalTimer) {
              clearInterval(
                intervalTimer
              );
            }
          } else {
            startGlitchTimer();
          }
        }
      );

      startGlitchTimer();
    </script>
  </body>
</html>