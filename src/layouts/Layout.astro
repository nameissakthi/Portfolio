---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Sakthivel | Full-Stack Developer",
  description = "Sakthivel is a Full-Stack Developer specializing in Java, Spring Boot, React, TypeScript, and modern web applications.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sakthivel-d.vercel.app/" />
    <meta property="og:site_name" content="Sakthivel" />

    <!-- OG Image (Open Graph Image) -->
    <meta
      property="og:image"
      content="https://sakthivel-d.vercel.app/og-image.png"
    />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content={description} />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://sakthivel-d.vercel.app/" />

    <meta name="theme-color" content="#0a0a0a" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />

    <link rel="shortcut icon" href="/favicon.svg?v=4" />

    <title>{title}</title>

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Sakthivel",
        url: "https://sakthivel-d.vercel.app/",
        jobTitle: "Full-Stack Developer",
        email: "mailto:svel7252@gmail.com",
        sameAs: [
          "https://github.com/nameissakthi",
          "https://linkedin.com/in/sakthiveldhanushkodi",
        ],
      })}
    />

    <!-- Vercel -->
    <Analytics />
    <SpeedInsights />
  </head>

  <body>
    <slot />

    <script>
      const originalTitle = "Sakthivel";

      const glitchFrames = [
        "Sakthive_",
        "Sakthiv3l",
        "Sakth!vel",
        "Sakth1vel",
        "Sakthivel",
      ];

      let isGlitching = false;
      let glitchTimer: number | undefined;
      let intervalTimer: number | undefined;

      const glitchTitle = () => {
        if (document.hidden || isGlitching) {
          return;
        }

        isGlitching = true;

        let frame = 0;

        glitchTimer = window.setInterval(() => {
          if (document.hidden) {
            if (glitchTimer) {
              clearInterval(glitchTimer);
            }

            document.title = originalTitle;
            isGlitching = false;

            return;
          }

          document.title = glitchFrames[frame];

          frame++;

          if (frame >= glitchFrames.length) {
            if (glitchTimer) {
              clearInterval(glitchTimer);
            }

            document.title = originalTitle;

            isGlitching = false;
          }
        }, 90);
      };

      const startGlitchTimer = () => {
        if (intervalTimer) {
          clearInterval(intervalTimer);
        }

        if (!document.hidden) {
          intervalTimer = window.setInterval(() => {
            if (!document.hidden) {
              glitchTitle();
            }
          }, 7000);
        }
      };

      window.setTimeout(() => {
        if (!document.hidden) {
          glitchTitle();
        }
      }, 1500);

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          if (glitchTimer) {
            clearInterval(glitchTimer);
          }

          document.title = originalTitle;

          isGlitching = false;

          if (intervalTimer) {
            clearInterval(intervalTimer);
          }
        } else {
          startGlitchTimer();
        }
      });

      startGlitchTimer();
    </script>
  </body>
</html>
